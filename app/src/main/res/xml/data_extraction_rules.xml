<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup to your Google account and phone-to-phone transfer. Only your data,
     never device-specific state (armed alarms, the chosen backup folder). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="events.json" />
        <include domain="file" path="love.json" />
        <include domain="file" path="moods.tsv" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="events.json" />
        <include domain="file" path="love.json" />
        <include domain="file" path="moods.tsv" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
